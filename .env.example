# Environment variables for the IEEE AAST Cairo website (Create React App).
# Copy this file to `.env` and fill in real values. Restart `npm start` after editing.
# Full step-by-step instructions for generating every value below: see ENV_SETUP.md

# --- Google Apps Script web app URLs (each must end with /exec) ---
REACT_APP_GOOGLE_SHEETS_URL=
REACT_APP_CONTACT_FORM_URL=
REACT_APP_GAS_EMAIL_WEBHOOK_URL=
REACT_APP_SHEETS_VERIFY_URL=
REACT_APP_GOOGLE_SHEETS_FORMS_URL=

# --- Supabase configuration ---
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
